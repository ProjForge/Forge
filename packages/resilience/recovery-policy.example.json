{
  "version": 1,
  "outputDirectory": "D:\\FORGE Backups\\logical",
  "replicas": [
    {
      "name": "filesystem-primary",
      "type": "filesystem",
      "path": "\\\\backup-server\\FORGE\\logical"
    },
    {
      "name": "offsite-worm",
      "type": "s3",
      "bucket": "forge-recovery-prod",
      "prefix": "logical",
      "region": "eu-west-1",
      "objectLock": {
        "mode": "COMPLIANCE",
        "retentionDays": 30
      }
    }
  ],
  "retention": {
    "keepLast": 14,
    "maxAgeHours": 720
  },
  "labelPrefix": "scheduled",
  "lockPath": "C:\\ProgramData\\FORGE\\resilience.lock",
  "statusPath": "C:\\ProgramData\\FORGE\\resilience-status.json"
}
