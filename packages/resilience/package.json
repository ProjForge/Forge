{
  "name": "forge-resilience",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "forge-resilience": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "scripts",
    "recovery-policy.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "npm run test:compile && node --test .test-dist/tests/unit/config.test.js .test-dist/tests/unit/crypto.test.js .test-dist/tests/unit/manifest.test.js .test-dist/tests/unit/physical.test.js .test-dist/tests/unit/policy.test.js .test-dist/tests/unit/s3.test.js .test-dist/tests/integration/s3-sdk.test.js",
    "test:integration": "npm run build && npm run test:compile && node --test .test-dist/tests/integration/s3-sdk.test.js .test-dist/tests/integration/native-recovery.test.js",
    "test:all": "npm run build && npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1107.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
