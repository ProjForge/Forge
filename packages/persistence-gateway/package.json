{
  "name": "forge-persistence-gateway",
  "version": "0.1.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/tests/unit/json.test.js",
    "test:integration": "npm run test:compile && node --test .test-dist/tests/integration/continuity.test.js",
    "test:all": "npm run build && npm test && npm run test:integration",
    "smoke": "npm run build && node dist/cli/smoke.js"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
