{
  "name": "forge-embedding-worker",
  "version": "0.1.6",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "forge-embedding-worker": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "evaluation",
    "scripts"
  ],
  "bundledDependencies": [
    "forge-persistence-gateway"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "npm run test:compile && node --test .test-dist/tests/unit/provider.test.js .test-dist/tests/unit/worker.test.js .test-dist/tests/unit/continuous.test.js",
    "test:integration": "npm run build && npm run test:compile && node --test .test-dist/tests/integration/native-worker.test.js",
    "test:all": "npm run build && npm run test:unit && npm run test:integration",
    "smoke:live-query": "node scripts/live-query-smoke.mjs",
    "eval:multilingual-v2": "node scripts/run-evaluation-v2.mjs",
    "eval:reranker-v2": "node scripts/run-reranker-evaluation-v2.mjs"
  },
  "dependencies": {
    "forge-persistence-gateway": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
