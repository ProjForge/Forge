{
  "name": "forge-mcp-server",
  "version": "0.1.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "forge-mcp-server": "./dist/stdio.js",
    "forge-mcp-codex": "./dist/codex.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "scripts/configure-codex-secret.ps1",
    "scripts/check-codex-registration.mjs"
  ],
  "bundledDependencies": [
    "forge-persistence-gateway"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/stdio.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "npm run test:compile && node --test .test-dist/tests/unit/server.test.js",
    "test:integration": "npm run build && npm run test:compile && node --test .test-dist/tests/integration/mcp-continuity.test.js",
    "test:codex": "node scripts/check-codex-registration.mjs",
    "test:all": "npm run build && npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "forge-persistence-gateway": "0.1.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "bundleDependencies": [
    "forge-persistence-gateway"
  ]
}
