{
  "name": "forge-workbench",
  "version": "0.2.0-rc.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "forge-workbench": "./dist/main.js",
    "forge-workbench-windows": "./dist/windows-launcher.js"
  },
  "files": ["dist", "public", "packaging", "README.md", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/tests/server.test.js .test-dist/tests/service.test.js .test-dist/tests/windows-config.test.js .test-dist/tests/recovery-health.test.js",
    "start": "node dist/main.js",
    "start:windows": "node dist/windows-launcher.js",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/windows/Build-Windows-Package.ps1"
  },
  "dependencies": {
    "forge-semantic-bridge": "0.1.4"
  },
  "bundledDependencies": [
    "forge-semantic-bridge"
  ],
  "devDependencies": {
    "@types/node": "24.13.3",
    "@yao-pkg/pkg": "6.22.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "pkg": {
    "scripts": ["dist/**/*.js"],
    "outputPath": "packaging/windows/.build"
  },
  "engines": { "node": ">=20" }
}
