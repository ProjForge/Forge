{
  "name": "forge-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "External trusted-host pilot coordinator for FORGE tasks",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "forge-coordinator-pilot": "./dist/cli.js" },
  "files": ["dist", "sql", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/tests/unit.test.js .test-dist/tests/agent-effects.test.js .test-dist/tests/recovery.test.js",
    "test:integration": "npm run build && npm run test:compile && node --test .test-dist/tests/native.test.js"
  },
  "dependencies": { "forge-persistence-gateway": "0.1.5", "pg": "8.23.0" },
  "devDependencies": { "@types/node": "24.13.3", "@types/pg": "8.21.0", "typescript": "5.9.3" },
  "engines": { "node": ">=20" }
}
