{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "declaration": true,
    "declarationMap": true, "sourceMap": true, "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true, "verbatimModuleSyntax": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"], "exclude": ["dist", "node_modules", "tests"]
}
